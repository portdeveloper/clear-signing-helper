{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": { "contract": { "deployments": [{ "chainId": 10143, "address": "0xe23B3825F950637256e8DE1BF39743E8f29D97F1" }] } },
  "metadata": { "owner": "PuddleSwap", "contractName": "StakingRewards" },
  "display": {
    "formats": {
      "exit()": { "intent": "Unstake all and claim rewards", "fields": [], "interpolatedIntent": "Unstake all and claim rewards" },
      "getReward()": { "intent": "Claim rewards", "fields": [], "interpolatedIntent": "Claim staking rewards" },
      "grantRole(bytes32 role,address account)": {
        "intent": "Grant role",
        "fields": [
          { "path": "role", "label": "Role", "format": "raw" },
          { "path": "account", "label": "Account", "format": "addressName", "params": { "types": ["eoa", "wallet"] } }
        ],
        "interpolatedIntent": "Grant role to {account}"
      },
      "notifyRewardAmount(uint256 reward)": {
        "intent": "Start reward period",
        "fields": [
          {
            "path": "reward",
            "label": "Reward amount",
            "format": "tokenAmount",
            "params": { "token": "0x97B3070F9Da6C002343862b35E68Bd8e22608943" }
          }
        ],
        "interpolatedIntent": "Start {reward} reward period"
      },
      "recoverERC20(address token,address to,uint256 amount)": {
        "intent": "Recover tokens",
        "fields": [
          { "path": "token", "label": "Token", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "to", "label": "Recipient", "format": "addressName", "params": { "types": ["eoa", "wallet"] } },
          { "path": "amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "token" } }
        ],
        "interpolatedIntent": "Recover {amount} to {to}"
      },
      "renounceRole(bytes32 role,address callerConfirmation)": {
        "intent": "Renounce role",
        "fields": [
          { "path": "role", "label": "Role", "format": "raw" },
          { "path": "callerConfirmation", "label": "Your account", "format": "addressName", "params": { "types": ["eoa", "wallet"] } }
        ],
        "interpolatedIntent": "Renounce role"
      },
      "revokeRole(bytes32 role,address account)": {
        "intent": "Revoke role",
        "fields": [
          { "path": "role", "label": "Role", "format": "raw" },
          { "path": "account", "label": "Account", "format": "addressName", "params": { "types": ["eoa", "wallet"] } }
        ],
        "interpolatedIntent": "Revoke role from {account}"
      },
      "setRewardsDuration(uint256 rewardsDuration_)": {
        "intent": "Set reward duration",
        "fields": [{ "path": "rewardsDuration_", "label": "Reward duration", "format": "duration" }],
        "interpolatedIntent": "Set period: {rewardsDuration_}"
      },
      "stake(uint256 amount)": {
        "intent": "Stake LP tokens",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to stake",
            "format": "tokenAmount",
            "params": { "token": "0x1FBC7b6B54726D735fF1B47Df75535B4B9021902" }
          }
        ],
        "interpolatedIntent": "Stake {amount}"
      },
      "withdraw(uint256 amount)": {
        "intent": "Unstake LP tokens",
        "fields": [
          {
            "path": "amount",
            "label": "Amount to unstake",
            "format": "tokenAmount",
            "params": { "token": "0x1FBC7b6B54726D735fF1B47Df75535B4B9021902" }
          }
        ],
        "interpolatedIntent": "Unstake {amount}"
      }
    }
  }
}
