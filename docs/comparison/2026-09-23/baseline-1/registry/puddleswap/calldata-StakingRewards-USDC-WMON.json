{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "$id": "StakingRewards USDC/WMON",
    "contract": { "deployments": [{ "chainId": 10143, "address": "0xe23B3825F950637256e8DE1BF39743E8f29D97F1" }] }
  },
  "metadata": {
    "owner": "PuddleSwap",
    "contractName": "StakingRewards",
    "info": { "url": "https://puddleswap.org", "deploymentDate": "2026-06-24T15:43:35Z" },
    "constants": {
      "stakingToken": "0x1FBC7b6B54726D735fF1B47Df75535B4B9021902",
      "rewardsToken": "0x97B3070F9Da6C002343862b35E68Bd8e22608943"
    }
  },
  "display": {
    "formats": {
      "stake(uint256 amount)": {
        "$id": "stake",
        "intent": "Stake LP tokens",
        "interpolatedIntent": "Stake {#.amount} (USDC/WMON)",
        "fields": [
          {
            "path": "#.amount",
            "label": "USDC/WMON LP amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.stakingToken" }
          }
        ]
      },
      "withdraw(uint256 amount)": {
        "$id": "withdraw",
        "intent": "Unstake LP tokens",
        "interpolatedIntent": "Unstake {#.amount} (USDC/WMON)",
        "fields": [
          {
            "path": "#.amount",
            "label": "USDC/WMON LP amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.stakingToken" }
          }
        ]
      },
      "getReward()": { "$id": "getReward", "intent": "Claim WMON rewards", "interpolatedIntent": "Claim WMON staking rewards", "fields": [] },
      "exit()": { "$id": "exit", "intent": "Unstake all and claim", "interpolatedIntent": "Unstake all and claim rewards", "fields": [] },
      "notifyRewardAmount(uint256 reward)": {
        "$id": "notifyRewardAmount",
        "intent": "Start reward period",
        "interpolatedIntent": "Start {#.reward} reward period",
        "fields": [
          {
            "path": "#.reward",
            "label": "Reward amount",
            "format": "tokenAmount",
            "params": { "token": "$.metadata.constants.rewardsToken" }
          }
        ]
      },
      "setRewardsDuration(uint256 rewardsDuration_)": {
        "$id": "setRewardsDuration",
        "intent": "Set reward period length",
        "interpolatedIntent": "Period of {#.rewardsDuration_}",
        "fields": [{ "path": "#.rewardsDuration_", "label": "New reward period", "format": "duration" }]
      },
      "recoverERC20(address token,address to,uint256 amount)": {
        "$id": "recoverERC20",
        "intent": "Recover stuck tokens",
        "interpolatedIntent": "Recover {#.amount} to {#.to}",
        "fields": [
          { "path": "#.amount", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "#.token" } },
          { "path": "#.token", "label": "Token", "format": "addressName", "params": { "types": ["token"] } },
          { "path": "#.to", "label": "Recipient", "format": "addressName", "params": { "types": ["eoa", "contract", "wallet"] } }
        ]
      },
      "grantRole(bytes32 role,address account)": {
        "$id": "grantRole",
        "intent": "Grant role",
        "interpolatedIntent": "Grant role to {#.account}",
        "fields": [
          { "path": "#.role", "label": "Role", "format": "raw" },
          { "path": "#.account", "label": "Account", "format": "addressName", "params": { "types": ["eoa", "contract", "wallet"] } }
        ]
      },
      "revokeRole(bytes32 role,address account)": {
        "$id": "revokeRole",
        "intent": "Revoke role",
        "interpolatedIntent": "Revoke role from {#.account}",
        "fields": [
          { "path": "#.role", "label": "Role", "format": "raw" },
          { "path": "#.account", "label": "Account", "format": "addressName", "params": { "types": ["eoa", "contract", "wallet"] } }
        ]
      },
      "renounceRole(bytes32 role,address callerConfirmation)": {
        "$id": "renounceRole",
        "intent": "Renounce role",
        "interpolatedIntent": "Renounce role {#.role}",
        "fields": [
          { "path": "#.role", "label": "Role", "format": "raw" },
          { "path": "#.callerConfirmation", "label": "Your account", "format": "addressName", "params": { "types": ["wallet"] } }
        ]
      }
    }
  }
}
